const P=$$('.pg'),dots=$('#dots');let cur=0,tm,busy=0;
P.forEach(p=>p.querySelectorAll('.sl').forEach((e,k)=>e.style.setProperty('--k',k)));
P.forEach((p,i)=>{const b=document.createElement('button');b.setAttribute('aria-label',NAMES[i]);b.onclick=()=>go(i);dots.append(b)});
function talk(i){const box=P[i].querySelector('.dlg'),L=D[i];if(!box||!L)return;clearTimeout(tm);box.innerHTML='';let k=0;
const nx=()=>{if(k>=L.length||cur!=i)return;const[w,t]=L[k++],b=document.createElement('p');b.className='bb '+w;b.innerHTML=`<span aria-hidden="true"></span><span class="vh">${t}</span>`;box.append(b);const s=b.firstChild;
if(rm){s.textContent=t;nx();return}let c=0;(function ty(){s.textContent=t.slice(0,++c);if(c<t.length)tm=setTimeout(ty,20);else tm=setTimeout(nx,650)})()};nx()}
function skip(){clearTimeout(tm);const box=P[cur].querySelector('.dlg'),L=D[cur];if(box&&L)box.innerHTML=L.map(([w,t])=>`<p class="bb ${w}" style="animation:none">${t}</p>`).join('')}
function go(n){if(n==cur||n<0||n>=P.length||busy)return;busy=1;setTimeout(()=>busy=0,500);const o=P[cur],w=P[n],fw=n>cur;clearTimeout(tm);P.forEach(p=>p.style.zIndex=0);
if(fw){w.className='pg on';w.style.zIndex=1;o.style.zIndex=2;o.className='pg fl'}else{w.className='pg fl';w.style.zIndex=2;o.style.zIndex=1;void w.offsetWidth;w.className='pg on';o.className='pg'}
setTimeout(()=>{if(o!=P[cur])o.className='pg'},800);cur=n;w.scrollTop=0;fx(innerWidth/2,innerHeight/2,'FWIP!');
$('#lab').textContent=`Page ${n+1} of ${P.length}: ${NAMES[n]}`;$('#skip').hidden=!D[n];$('#pv').disabled=!n;$('#nx').disabled=n==P.length-1;
[...dots.children].forEach((b,i)=>b.setAttribute('aria-current',i==n));$('#hint')?.remove();setTimeout(()=>talk(n),rm?0:600)}
function fx(x,y,t){if(rm)return;const b=document.createElement('div');b.className='bz';b.textContent=t||['THWIP!','POW!','ZAP!','BAM!'][Math.random()*4|0];b.style.left=x+'px';b.style.top=y+'px';document.body.append(b);setTimeout(()=>b.remove(),650)}
dots.children[0].setAttribute('aria-current',true);$('#pv').disabled=true;
setTimeout(()=>{const h=$('#hint');h&&h.remove()},6000);
$('#pv').onclick=()=>go(cur-1);$('#nx').onclick=()=>go(cur+1);$('#skip').onclick=skip;
$$('[data-go]').forEach(b=>b.onclick=()=>go(+b.dataset.go));
$('#sl').onclick=()=>$('#strip').scrollBy({left:-290,behavior:'smooth'});$('#sr').onclick=()=>$('#strip').scrollBy({left:290,behavior:'smooth'});
const qv=$('#qv'),openQ=()=>{qv.hidden=false;$('#qc').focus()},closeQ=()=>qv.hidden=true;
$('#qb').onclick=$('#qb2').onclick=openQ;$('#qc').onclick=closeQ;
const lb=$('#lb'),li=$('#lb img');$$('.fr').forEach(f=>f.onclick=()=>{li.src=f.dataset.src;li.alt=f.dataset.alt;lb.classList.add('on')});lb.onclick=()=>lb.classList.remove('on');
addEventListener('keydown',e=>{if(e.key=='Escape'){lb.classList.remove('on');closeQ()}else if(!qv.hidden||lb.classList.contains('on')||e.target.closest('input'))return;else if(e.key=='ArrowRight')go(cur+1);else if(e.key=='ArrowLeft')go(cur-1)});
let sx=0,sy=0;addEventListener('touchstart',e=>{sx=e.touches[0].clientX;sy=e.touches[0].clientY},{passive:true});
